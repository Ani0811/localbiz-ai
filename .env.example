# ============================================================
# LocalBiz AI - Environment Configuration
# ============================================================

# LM Studio Host Address
# - When running natively on Windows: http://localhost:1234/v1
# - When running inside Podman containers: http://host.containers.internal:1234/v1
#   (Note: Run `lms server start --bind 0.0.0.0 --cors` so the container can connect)
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Target Open-Weight Model Identifier in LM Studio
# Tested 3B-4B models:
# - google/gemma-3-4b (Recommended for balanced creative & structured marketing)
# - nvidia/nemotron-3-nano-4b (Recommended for reasoning)
LM_STUDIO_MODEL=google/gemma-3-4b

# Optional API Key (leave empty for default local LM Studio)
LM_STUDIO_API_KEY=

# Inference request timeout in seconds (allow sufficient time for 3B-4B models)
LM_STUDIO_TIMEOUT=90.0

# SQLite Database Location
DB_PATH=data/localbiz.db

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000
